# Copy this file to secrets.yaml and fill in your own values.
# secrets.yaml is gitignored and must NEVER be committed.

wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"
fallback_ap_password: "fallback-ap-password"

# Generate with: openssl rand -base64 32
bt_api_encryption_key: "base64-encoded-32-byte-key=="

# Any password you like (used for OTA updates)
bt_ota_password: "your-ota-password"
